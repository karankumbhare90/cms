DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# ==============================================================
# AI CHATBOT & MULTI-PROVIDER / MULTI-KEY FAILOVER CONFIGURATION
# ==============================================================
# You can configure one or more AI providers below.
# When a provider hits a rate limit (HTTP 429) or runs out of quota,
# the system automatically and instantly fails over to the next
# available key/provider so your users never see an error message!

# --- 1. Google Gemini ---
# Single key:
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# Optional multiple keys (comma-separated or numbered):
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_API_KEY_1=key1
# GEMINI_API_KEY_2=key2
# Model (default: gemini-2.0-flash):
GEMINI_MODEL=gemini-2.0-flash

# --- 2. OpenAI / ChatGPT ---
# Single key:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- 3. DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Model (default: deepseek-chat):
DEEPSEEK_MODEL=deepseek-chat

# --- 4. OmniRoute (AI Gateway & Router for multi-model fallback) ---
# If running OmniRoute locally via Docker or Node:
OMNIROUTE_API_KEY=your_omniroute_key_or_dummy
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Model (default: auto):
OMNIROUTE_MODEL=auto

# --- 5. OpenRouter (Optional backup) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Provider Priority Order ---
# Customize failover order (default: gemini,openai,deepseek,omniroute,openrouter)
# AI_PROVIDER_ORDER=gemini,openai,deepseek,omniroute